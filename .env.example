# Copy this file to ".env" (same folder) and fill in values you want to use.
# Everything is optional: SearchRo runs without any of these.

# --- Optional AI features (resume improvement, cover letters, interview Q&A, chat) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional tuning ---
# Seconds to wait for each job API before giving up
SEARCHRO_REQUEST_TIMEOUT=10
# Seconds to wait for the OpenAI API
SEARCHRO_AI_TIMEOUT=60
# Use a different database file (default: data/searchro.db)
# SEARCHRO_DB_PATH=data/searchro.db

# --- Optional: change the external search-link formats if a site changes its URLs ---
# LINKEDIN_JOBS_URL=https://www.linkedin.com/jobs/search/
# NAUKRI_URL_ROLE_LOCATION=https://www.naukri.com/{role}-jobs-in-{location}
# NAUKRI_URL_ROLE_ONLY=https://www.naukri.com/{role}-jobs
# NAUKRI_URL_LOCATION_ONLY=https://www.naukri.com/jobs-in-{location}
